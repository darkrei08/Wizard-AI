{
  "mcpServers": {
    "wizard-ai-core": {
      "command": "node",
      "args": ["bin/mcp-server.js"]
    },
    "serena": {
      "command": "serena",
      "args": ["start-mcp-server", "--project-from-cwd"]
    }
  },
  "globalContext": {
    "rules": [
      ".agents/AGENTS.md",
      "CLAUDE.md",
      "GEMINI.md"
    ],
    "memory": "MEMORY.md"
  }
}
