RED='\033[0;31m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
DIM='\033[2m'
RESET='\033[0m'

check_cmd() {
  if command -v "$1" &>/dev/null; then
    echo "✅"
  else
    echo "❌"
  fi
}

